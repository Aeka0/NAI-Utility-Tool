<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <NaitoolBuildDirectory Condition="'$(NaitoolBuildDirectory)' == ''">$(MSBuildThisFileDirectory)../../build/$(Configuration)/bin</NaitoolBuildDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="NAI Utility Tool">
      <HintPath>$(NaitoolBuildDirectory)/NAI Utility Tool.dll</HintPath>
    </Reference>
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
  </ItemGroup>
</Project>
